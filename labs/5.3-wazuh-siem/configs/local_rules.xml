<!-- Local rule groups -->
<group name="local,">

  <!-- Example SSH rule -->
  <group name="syslog,sshd,">

  <!--
  Dec 10 01:02:02 host sshd[1234]: Failed none for root from 1.1.1.1 port 1066 ssh2
  -->
  <rule id="100001" level="5">
    <if_sid>5716</if_sid>
    <srcip>1.1.1.1</srcip>
    <description>sshd: authentication failed from IP 1.1.1.1.</description>
    <group>authentication_failed,pci_dss_10.2.4,pci_dss_10.2.5,</group>
  </rule>

  </group>

  <!-- Custom sudo rules -->
  <group name="sudo,">

  <!-- Failed sudo attempt -->
  <rule id="100100" level="8">
    <if_sid>5401</if_sid>
    <description>Linux: Failed sudo authentication attempt</description>
    <group>authentication_failed,</group>
  </rule>

  <!-- Successful sudo to root -->
  <rule id="100101" level="5">
    <if_sid>5402</if_sid>
    <description>Linux: Successful sudo command executed as root</description>
    <group>privilege_escalation,</group>
  </rule>

  <!-- Successful sudo execution -->
  <rule id="100102" level="5">
    <if_sid>5407</if_sid>
    <description>Linux: Successful sudo command execution</description>
    <group>privilege_escalation,</group>
  </rule>

  <!-- First-time successful sudo execution -->
  <rule id="100103" level="5">
    <if_sid>5403</if_sid>
    <description>Linux: First-time successful sudo execution</description>
    <group>privilege_escalation,</group>
  </rule>

</group>

</group>
